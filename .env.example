# ============================================================================
# PRODUCTION CHECKLIST — before this app goes live, these MUST change:
#   APP_ENV=production           (currently local)
#   APP_DEBUG=false              (currently true — leaks stack traces otherwise)
#   APP_URL=https://yourdomain   (currently localhost — feeds every canonical/
#                                  OG/sitemap URL the site generates)
#   DB_CONNECTION=mysql + DB_HOST/DB_DATABASE/DB_USERNAME/DB_PASSWORD
#                                 (currently sqlite — fine for low traffic, but
#                                  confirm this is still the plan before launch)
#   MAIL_MAILER=smtp + real MAIL_HOST/MAIL_USERNAME/MAIL_PASSWORD
#                                 (currently "log" — contact form notifications
#                                  are written to the log file, not emailed)
#   SESSION_SECURE_COOKIE=true   (once served over HTTPS)
# ============================================================================

APP_NAME="LSA - LEGIT SOURCE ANALYSIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Shared secret the algorithm's sync_to_website.py sends as X-Sync-Key when
# pushing/updating predictions (routes/api.php). Generate with
# `python -c "import secrets; print(secrets.token_hex(24))"` and set the SAME
# value as LSA_SYNC_SECRET in algorithm/.env. Leaving this blank makes the
# sync endpoint refuse all requests (fails closed, see VerifySyncKey).
SYNC_SHARED_SECRET=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lsa
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes mail to storage/logs/laravel.log instead of sending it — fine
# for local dev, must become "smtp" (or another real driver) before launch.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@legitsourceanalysis.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where contact-form submissions get emailed to. Defaults to the public
# contact address shown across the site if left unset.
LSA_ADMIN_EMAIL="info@legitsourceanalysis.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
